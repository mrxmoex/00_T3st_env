{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.dbwdi/schemas/dataset-meta.json",
  "title": "DatasetMeta",
  "type": "object",
  "required": ["id", "version", "verifiedAt", "engineVersion", "primaryStandards"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "version": { "type": "string" },
    "verifiedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "engineVersion": { "type": "string" },
    "primaryStandards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "url", "role"]
      }
    },
    "flaggedAsEstimated": { "type": "array", "items": { "type": "string" } },
    "futureExtensions": { "type": "array", "items": { "type": "string" } }
  }
}
